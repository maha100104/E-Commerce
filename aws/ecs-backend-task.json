{
  "family": "ecommerce-backend-task",
  "executionRoleArn": "arn:aws:iam::835597620569:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::835597620569:role/ecommerce-backend-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "ecommerce-backend",
      "image": "835597620569.dkr.ecr.ap-south-1.amazonaws.com/ecommerce-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-south-1:835597620569:parameter/ecommerce/DB_HOST"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:ssm:ap-south-1:835597620569:parameter/ecommerce/DB_USER"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-south-1:835597620569:parameter/ecommerce/DB_PASSWORD"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:ssm:ap-south-1:835597620569:parameter/ecommerce/DB_NAME"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-south-1:835597620569:parameter/ecommerce/JWT_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecommerce-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}